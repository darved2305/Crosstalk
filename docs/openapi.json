        "type": "object"
      },
      "SessionPlan": {
        "additionalProperties": false,
        "description": "One collected session.\n\nEither ``requests`` (synthetic validation traffic) or ``workload`` plus ``per_class``\n(corpus-driven, block-randomized traffic) defines the slots.",
        "properties": {
          "arm": {
            "default": "a0",
            "title": "Arm",
            "type": "string"
          },
          "arms": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Arms"
          },
          "classes": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classes"
          },
          "concurrency": {
            "maximum": 256.0,
            "minimum": 1.0,
            "title": "Concurrency",
            "type": "integer"
          },
          "concurrency_levels": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Concurrency Levels"
          },
          "cycles": {
            "default": 1,
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Cycles",
            "type": "integer"
          },
          "determinism_every": {
            "default": 25,
            "minimum": 0.0,
            "title": "Determinism Every",
            "type": "integer"
          },
          "experiment_id": {
            "title": "Experiment Id",
            "type": "string"
          },
          "max_completion_tokens": {
            "default": 512,
            "maximum": 999.0,
            "minimum": 100.0,
            "title": "Max Completion Tokens",
            "type": "integer"
          },
          "model": {
            "default": "Qwen/Qwen2.5-1.5B-Instruct",
            "title": "Model",
            "type": "string"
          },
          "per_class": {
            "anyOf": [
              {
                "maximum": 10000.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Per Class"
          },
          "regime": {
            "$ref": "#/components/schemas/Regime",
            "default": "NAT"
          },
          "requests": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requests"
          },
          "seed": {
            "minimum": 0.0,
            "title": "Seed",
            "type": "integer"
          },
          "stream_interval": {
            "default": 1,
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Stream Interval",
            "type": "integer"
          },
          "stream_interval_arms": {
            "items": {
              "type": "string"
            },
            "title": "Stream Interval Arms",
            "type": "array"
          },
          "stream_interval_variants": {
            "items": {
              "type": "integer"
            },
            "title": "Stream Interval Variants",
            "type": "array"
          },
          "target_lengths": {
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "title": "Target Lengths",
            "type": "array"
          },
          "temperature": {
            "default": 0.7,
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "type": "number"
          },
          "validation": {
            "default": true,
            "title": "Validation",
            "type": "boolean"
          },
          "warmup": {
            "default": 30,
            "minimum": 0.0,
            "title": "Warmup",
            "type": "integer"
          },
          "workload": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workload"
          }
        },
        "required": [
          "experiment_id",
          "concurrency",
          "seed"
        ],
        "title": "SessionPlan",
        "type": "object"
      },
      "SessionView": {
        "additionalProperties": false,
        "properties": {
          "cancel_requested": {
            "title": "Cancel Requested",
            "type": "boolean"
          },
          "experiment_id": {
            "title": "Experiment Id",
            "type": "string"
          },
          "id": {
